# Backend environment configuration. Copy this file to `.env` and adjust as needed.
# The real `.env` file is git-ignored.

# Server port
PORT=5000

# JWT signing secret – use a long random value in production
JWT_SECRET=change_me_to_a_long_random_secret

# Token expiry duration
JWT_EXPIRES_IN=2h

# Runtime environment: development | production
NODE_ENV=development

# Comma-separated CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173