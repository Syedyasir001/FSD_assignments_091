# MongoDB connection string. Copy this file to `.env` and fill in your values.
# The real `.env` file is git-ignored so database credentials are never published.
#
# Local MongoDB (no credentials):
# MONGODB_URI=mongodb://127.0.0.1:27017/furnish_india
#
# MongoDB Atlas example (replace <user>, <password>, <cluster> with your values):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster1