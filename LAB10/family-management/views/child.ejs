<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Child Profile</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="glass-header">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; padding: 0 2rem;">
      <h2 style="margin: 0; font-size: 1.5rem;">Family Management</h2>
      <a href="/users/<%= child.parentId %>" style="color: var(--primary-color); text-decoration: none;">&larr; Back to Parent</a>
    </div>
  </div>
  <div class="container">
    <header>
      <h1>Child Profile</h1>
    </header>
    
    <div class="card">
      <h3>Update Information</h3>
      <form id="updateChildForm">
        <div class="form-group">
          <label>First Name</label>
          <input type="text" id="c-fn" class="form-control" value="<%= child.firstName %>" required>
        </div>
        <div class="form-group">
          <label>Last Name</label>
          <input type="text" id="c-ln" class="form-control" value="<%= child.lastName %>" required>
        </div>
        <div class="form-group">
          <label>Age</label>
          <input type="number" id="c-age" class="form-control" value="<%= child.age %>" required>
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" id="c-em" class="form-control" value="<%= child.email || '' %>">
        </div>
        <button type="submit" class="btn">Update Child</button>
      </form>
    </div>
  </div>
  
  <script>
    const childId = '<%= child._id %>';
    document.getElementById('updateChildForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const fn = document.getElementById('c-fn').value;
      const ln = document.getElementById('c-ln').value;
      const age = document.getElementById('c-age').value;
      const em = document.getElementById('c-em').value;
      
      const res = await fetch(`/children/${childId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ firstName: fn, lastName: ln, age: age, email: em })
      });
      const data = await res.json();
      if(res.ok) {
        alert(data.message);
        window.location.reload();
      } else {
        alert(data.error);
      }
    });
  </script>
</body>
</html>
