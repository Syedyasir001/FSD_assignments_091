<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Users</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="glass-header">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; padding: 0 2rem;">
      <h2 style="margin: 0; font-size: 1.5rem;">Family Management</h2>
    </div>
  </div>
  <div class="container">
    <header>
      <h1>All Users</h1>
      <p>Select a user to view their profile</p>
    </header>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem;">
      <% users.forEach(user => { %>
        <div class="card" style="margin-bottom: 0;">
          <h3 style="margin-top: 0;"><%= user.firstName %> <%= user.lastName %></h3>
          <p class="badge"><%= user.email %></p>
          <div style="margin-top: 1.5rem;">
            <a href="/users/<%= user._id %>" class="btn" style="width: 100%; text-align: center; box-sizing: border-box;">View Profile</a>
          </div>
        </div>
      <% }) %>
    </div>
    
    <div class="card" style="margin-top: 3rem;">
      <h3>Create New User</h3>
      <form id="createUserForm">
        <div class="form-group">
          <label>First Name</label>
          <input type="text" id="u-fn" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Last Name</label>
          <input type="text" id="u-ln" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" id="u-em" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Phone</label>
          <input type="text" id="u-ph" class="form-control" required>
        </div>
        <button type="submit" class="btn">Create User</button>
      </form>
    </div>
  </div>
  
  <script>
    document.getElementById('createUserForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const fn = document.getElementById('u-fn').value;
      const ln = document.getElementById('u-ln').value;
      const em = document.getElementById('u-em').value;
      const ph = document.getElementById('u-ph').value;
      
      const res = await fetch('/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ firstName: fn, lastName: ln, email: em, phone: ph })
      });
      const data = await res.json();
      if(res.ok) {
        alert(data.message);
        window.location.reload();
      } else {
        alert(data.error);
      }
    });
  </script>
</body>
</html>
