<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= user.firstName %>'s Profile</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="glass-header">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; padding: 0 2rem;">
      <h2 style="margin: 0; font-size: 1.5rem;">Family Management</h2>
      <a href="/users" style="color: var(--primary-color); text-decoration: none;">&larr; Back to Users</a>
    </div>
  </div>
  <div class="container">
    <header>
      <h1><%= user.firstName %> <%= user.lastName %></h1>
    </header>
    
    <div class="card">
      <h3>User Information</h3>
      <p><strong>Email:</strong> <%= user.email %></p>
      <p><strong>Phone:</strong> <%= user.phone %></p>
    </div>
    
    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <h3>Children</h3>
        <a href="/users/<%= user._id %>/add-child" class="btn">Add Child</a>
      </div>
      
      <% if(children.length === 0) { %>
        <p style="color: var(--text-muted); margin-top: 1rem;">No children found for this user.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Age</th>
              <th>Email</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% children.forEach(child => { %>
              <tr>
                <td><%= child.firstName %> <%= child.lastName %></td>
                <td><%= child.age %></td>
                <td><%= child.email || 'N/A' %></td>
                <td>
                  <a href="/users/<%= user._id %>/children/<%= child._id %>" class="btn" style="padding: 0.5rem 1rem; font-size: 0.875rem; margin-right: 0.5rem;">View</a>
                  <button onclick="deleteChild('<%= child._id %>')" class="btn btn-danger" style="padding: 0.5rem 1rem; font-size: 0.875rem;">Delete</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
  
  <script>
    async function deleteChild(childId) {
      if(confirm('Are you sure you want to delete this child?')) {
        const res = await fetch('/children/' + childId, { method: 'DELETE' });
        const data = await res.json();
        if(res.ok) {
          alert(data.message);
          window.location.reload();
        } else {
          alert(data.error);
        }
      }
    }
  </script>
</body>
</html>
