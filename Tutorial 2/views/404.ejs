<%- include('partials/header', { pageTitle: 'Page Not Found (404)' }) %>

<div class="empty-state" style="max-width: 600px; margin: 3rem auto;">
  <div class="empty-icon" style="font-size: 4.5rem; color: var(--primary);">&#128565;</div>
  <h1 style="font-size: 2.25rem; margin-bottom: 0.5rem;">404 - Page Not Found</h1>
  <p class="empty-desc">
    The URL <code><%= typeof url !== 'undefined' ? url : '' %></code> could not be found on this server. It may have been moved, deleted, or entered incorrectly.
  </p>

  <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
    <a href="/" class="btn btn-primary">Return to Homepage</a>
    <a href="/lost-items" class="btn btn-secondary">Browse Lost Items</a>
    <a href="/found-items" class="btn btn-secondary">Browse Found Items</a>
  </div>
</div>

<%- include('partials/footer') %>
