<%- include('partials/header', { pageTitle: 'Report a Lost Item' }) %>

<div style="max-width: 650px; margin: 0 auto;">
  <div style="margin-bottom: 1.5rem;">
    <a href="/lost-items" class="btn btn-secondary btn-sm">&larr; Back to Lost Items</a>
  </div>

  <div class="card">
    <div class="card-header">
      <h1 class="card-title" style="font-size: 1.5rem;">Report a Lost Item</h1>
    </div>

    <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.5rem;">
      Provide accurate details about the item you misplaced on campus. Other students can review this listing if they find it.
    </p>

    <form action="/lost-items" method="POST">
      <div class="form-group">
        <label for="reportedBy" class="form-label">Reporting Student *</label>
        <select name="reportedBy" id="reportedBy" class="form-select" required>
          <option value="">-- Select Your Student Profile --</option>
          <% if (students && students.length > 0) { %>
            <% students.forEach(stu => { %>
              <option value="<%= stu._id %>"><%= stu.fullName %> (<%= stu.department %> - <%= stu.email %>)</option>
            <% }) %>
          <% } %>
        </select>
        <div class="form-help">
          Not registered yet? <a href="/register-student" target="_blank">Register student profile</a> first.
        </div>
      </div>

      <div class="form-group">
        <label for="itemName" class="form-label">Item Name *</label>
        <input
          type="text"
          id="itemName"
          name="itemName"
          class="form-control"
          placeholder="e.g. Sony WH-1000XM4 Wireless Headphones"
          required
        >
      </div>

      <div class="form-group">
        <label for="category" class="form-label">Category *</label>
        <select name="category" id="category" class="form-select" required>
          <option value="">-- Choose Category --</option>
          <option value="Electronics">Electronics</option>
          <option value="Documents & IDs">Documents & IDs</option>
          <option value="Accessories">Accessories</option>
          <option value="Books & Stationery">Books & Stationery</option>
          <option value="Clothing">Clothing</option>
          <option value="Keys">Keys</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div class="form-group">
        <label for="lastSeenLocation" class="form-label">Last Seen Location *</label>
        <input
          type="text"
          id="lastSeenLocation"
          name="lastSeenLocation"
          class="form-control"
          placeholder="e.g. Main Library 2nd Floor Study Cubicle #14"
          required
        >
      </div>

      <div class="form-group">
        <label for="dateLost" class="form-label">Date Lost *</label>
        <input
          type="date"
          id="dateLost"
          name="dateLost"
          class="form-control"
          value="<%= new Date().toISOString().split('T')[0] %>"
          required
        >
      </div>

      <div class="form-group">
        <label for="description" class="form-label">Description &amp; Identifying Details *</label>
        <textarea
          id="description"
          name="description"
          class="form-textarea"
          placeholder="Describe color, brand, scratches, stickers, or special markings..."
          required
        ></textarea>
      </div>

      <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; margin-top: 1rem;">
        Publish Lost Item Report
      </button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
